{
  "name": "@agent-rooms/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "auth:generate": "pnpm dlx auth@latest generate --config auth.config.ts --output auth-schema.generated.ts --yes",
    "build": "tsup && node ./scripts/copy-web-build.mjs",
    "dev": "AGENT_ROOMS_MODE=cloud AGENT_ROOMS_AUTH_SECRET=dev-only-secret-never-set-this-in-a-deploy tsx watch src/cloud.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-rooms/core": "workspace:*",
    "@agent-rooms/db": "workspace:*",
    "@agent-rooms/protocol": "workspace:*",
    "@hono/node-server": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@agent-rooms/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "4.21.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
