{
  "name": "agent-rooms-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dashboard:seed": "pnpm --filter @agent-rooms/db dashboard:seed",
    "dashboard:dev": "pnpm dashboard:seed && AGENT_ROOMS_WEB_DATABASE_URL=\"file://$PWD/.agent-rooms/dashboard-dev.sqlite\" pnpm --filter @agent-rooms/web dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@agent-rooms/oxfmt-config": "workspace:*",
    "@agent-rooms/oxlint-config": "workspace:*",
    "@agent-rooms/typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.13.1"
}
