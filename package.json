{
  "name": "coordrooms-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "install:local": "node ./scripts/install-local.mjs",
    "publish:cli": "pnpm run check && turbo run build --filter=coordrooms && pnpm --filter coordrooms publish",
    "dev": "turbo run dev",
    "dashboard:seed": "pnpm --filter @coordrooms/db dashboard:seed",
    "dashboard:dev": "pnpm dashboard:seed && COORDROOMS_DEVELOPMENT=1 COORDROOMS_DASHBOARD_DATABASE_URL=\"file://$PWD/.coordrooms/dashboard-dev.sqlite\" pnpm --parallel --filter @coordrooms/api --filter @coordrooms/web dev",
    "hooks:install": "git config core.hooksPath .githooks",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:install-local",
    "test:install-local": "node --test scripts/install-local.test.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@coordrooms/oxfmt-config": "workspace:*",
    "@coordrooms/oxlint-config": "workspace:*",
    "@coordrooms/typescript-config": "workspace:*",
    "ora": "8.2.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "picocolors": "1.1.1",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.13.1"
}
